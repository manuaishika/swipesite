// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String    @unique
  password      String
  bio           String?
  avatar        String?
  interests     String    @default("[]") // JSON array of research interests
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  likedPapers   PaperLike[]
  savedPapers   SavedPaper[]
  comments      Comment[]
  replies       CommentReply[]
  collaborations Collaboration[]
  activities    Activity[]
  recommendations Recommendation[]
  following     Follow[]  @relation("UserFollows")
  followers     Follow[]  @relation("UserFollowers")

  // Peer-review practice
  practiceSessions    PracticeSession[]
  practiceSubmissions PracticeSubmission[]
  practiceAssignments PracticeReviewAssignment[]
  practiceReviews     PracticeReview[]
  practiceReports     PracticeReport[]
  practiceRateEvents  PracticeRateEvent[]
  opportunities       Opportunity[]

  // Notifications and the weekly email digest
  notifications       Notification[]
  emailDigest         Boolean   @default(true)
  lastDigestAt        DateTime?
}

model Paper {
  id            String    @id @default(cuid())
  title         String
  abstract      String
  authors       String    @default("[]") // JSON array
  doi           String?   @unique
  arxivId       String?   @unique
  url           String?
  pdfUrl        String?
  publishedDate DateTime?
  venue         String?
  keywords      String    @default("[]") // JSON array
  categories    String    @default("[]") // JSON array
  citations     Int       @default(0)
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  likes         PaperLike[]
  saves         SavedPaper[]
  comments      Comment[]
  recommendations Recommendation[]
  activities    Activity[]
  practiceAbstract PracticeAbstract?
}

model PaperLike {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  liked     Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId])
  @@index([paperId])
}

model SavedPaper {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  tags      String   @default("[]") // JSON array of the user's own labels, e.g. ["Read later","Methods"]
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  content   String
  kind      String   @default("discussion") // "review" | "question" | "discussion"
  verdict   String?  // reviews only: "promising" | "mixed" | "skeptical"
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  replies   CommentReply[]
  votes     CommentVote[]

  @@index([paperId, createdAt])
}

model CommentReply {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  content   String
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     CommentReplyVote[]
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  voteType  String   // "upvote" or "downvote"
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model CommentReplyVote {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  voteType  String   // "upvote" or "downvote"
  createdAt DateTime @default(now())

  reply     CommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
}

model Collaboration {
  id          String   @id @default(cuid())
  userId      String
  paperId     String?
  title       String
  description String
  status      String   @default("open") // "open", "in_progress", "closed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests    CollaborationRequest[]
}

model CollaborationRequest {
  id             String   @id @default(cuid())
  collaborationId String
  userId         String
  message        String?
  status         String   @default("pending") // "pending", "accepted", "rejected"
  createdAt      DateTime @default(now())

  collaboration  Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, userId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "like", "comment", "save", "collaboration", "follow"
  paperId   String?
  commentId String?
  targetUserId String? // For follow activities
  metadata  String?  @default("{}") // JSON string for additional data
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper?   @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  followingId  String
  createdAt    DateTime @default(now())

  follower     User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following    User     @relation("UserFollows", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  score     Float    // Recommendation score (0-1)
  reason    String?  // Why this paper was recommended
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId, score])
}


// ---------------------------------------------------------------------------
// Peer-review practice (timed abstract critiques with anonymous peer review)
// Reuses User (auth) and Paper (arXiv data). No AI features touch these tables.
// ---------------------------------------------------------------------------

// A Paper that has been curated into the practice library.
model PracticeAbstract {
  id        String   @id @default(cuid())
  paperId   String   @unique
  createdAt DateTime @default(now())

  paper       Paper                @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sessions    PracticeSession[]
  submissions PracticeSubmission[]
}

model PracticeSession {
  id               String   @id @default(cuid())
  userId           String
  abstractId       String
  durationMinutes  Int
  startedAt        DateTime @default(now())
  deadlineAt       DateTime
  noAiDeclaredAt   DateTime

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  abstract   PracticeAbstract @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  submission PracticeSubmission?

  @@index([userId, startedAt])
}

model PracticeSubmission {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      String
  abstractId  String
  answers     Json     // { q1..q7: string }
  status      String   @default("visible") // "visible" | "hidden"
  submittedAt DateTime @default(now())

  session     PracticeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  abstract    PracticeAbstract @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  assignments PracticeReviewAssignment[]
  reviews     PracticeReview[]

  @@index([userId])
  @@index([status, submittedAt])
}

model PracticeReviewAssignment {
  id           String    @id @default(cuid())
  submissionId String
  reviewerId   String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  submission PracticeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User               @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  review     PracticeReview?

  @@unique([submissionId, reviewerId])
  @@index([reviewerId])
}

model PracticeReview {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  submissionId String
  reviewerId   String
  scores       Json     // { q1: { clarity, evidence, alternatives }, ... } each 1-5
  comment      String
  helpful      Boolean?
  status       String   @default("visible") // "visible" | "hidden"
  createdAt    DateTime @default(now())

  assignment PracticeReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission PracticeSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User                     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model PracticeReport {
  id         String   @id @default(cuid())
  reporterId String
  targetType String   // "submission" | "review"
  targetId   String
  reason     String
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
}

model PracticeRateEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
}

// Community-posted research opportunities (internships, PhD/postdoc positions, collaborations).
// Listings past their deadline are hidden from the main list automatically.
model Opportunity {
  id           String    @id @default(cuid())
  userId       String
  title        String
  organization String
  type         String    // "internship" | "phd" | "postdoc" | "job" | "collaboration" | "other"
  url          String
  description  String
  deadline     DateTime? // null = rolling / no fixed deadline
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deadline])
}

// In-app notifications (replies, new posts in threads you're in). Also feed the weekly digest.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // "reply" | "thread_post"
  title     String
  body      String?
  href      String
  actorId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
